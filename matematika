<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#87CEEB">
    <title>Matematičke Kartice - Učenje kroz Igru</title>
    <style>
        body {
            box-sizing: border-box;
            font-family: 'Comic Sans MS', cursive, sans-serif;
            background: linear-gradient(135deg, #87CEEB 0%, #98FB98 50%, #FFB6C1 100%);
            background-size: 400% 400%;
            animation: gradientShift 8s ease infinite;
            margin: 0;
            padding: 10px;
            min-height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            overflow-x: hidden;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.3) 2px, transparent 2px),
                radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.3) 2px, transparent 2px),
                radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.2) 3px, transparent 3px),
                radial-gradient(circle at 90% 70%, rgba(255, 255, 255, 0.2) 2px, transparent 2px),
                radial-gradient(circle at 10% 30%, rgba(255, 255, 255, 0.3) 2px, transparent 2px);
            background-size: 200px 200px, 300px 300px, 150px 150px, 250px 250px, 180px 180px;
            animation: sparkle 6s linear infinite;
            pointer-events: none;
            z-index: -1;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes sparkle {
            0%, 100% { opacity: 0.8; transform: translateY(0px); }
            50% { opacity: 1; transform: translateY(-10px); }
        }

        .floating-shapes {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .shape {
            position: absolute;
            opacity: 0.6;
            animation: float 8s ease-in-out infinite;
        }

        .shape:nth-child(1) {
            top: 10%;
            left: 10%;
            font-size: 2rem;
            animation-delay: 0s;
        }

        .shape:nth-child(2) {
            top: 20%;
            right: 15%;
            font-size: 1.5rem;
            animation-delay: 2s;
        }

        .shape:nth-child(3) {
            bottom: 20%;
            left: 20%;
            font-size: 2.5rem;
            animation-delay: 4s;
        }

        .shape:nth-child(4) {
            bottom: 30%;
            right: 10%;
            font-size: 1.8rem;
            animation-delay: 6s;
        }

        .shape:nth-child(5) {
            top: 50%;
            left: 5%;
            font-size: 2rem;
            animation-delay: 1s;
        }

        .shape:nth-child(6) {
            top: 60%;
            right: 5%;
            font-size: 1.6rem;
            animation-delay: 3s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            25% { transform: translateY(-20px) rotate(5deg); }
            50% { transform: translateY(-10px) rotate(-5deg); }
            75% { transform: translateY(-15px) rotate(3deg); }
        }

        .game-container {
            background: linear-gradient(135deg, #FFE5F1 0%, #E5F3FF 25%, #F0FFE5 50%, #FFF5E5 75%, #F5E5FF 100%);
            background-size: 400% 400%;
            animation: gradientShift 12s ease infinite;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            max-width: 100%;
            width: 100%;
            text-align: center;
            margin: 0 auto;
            min-height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .game-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 15% 25%, rgba(255, 182, 193, 0.4) 3px, transparent 3px),
                radial-gradient(circle at 85% 75%, rgba(173, 216, 230, 0.4) 2px, transparent 2px),
                radial-gradient(circle at 45% 15%, rgba(144, 238, 144, 0.3) 4px, transparent 4px),
                radial-gradient(circle at 75% 45%, rgba(255, 218, 185, 0.4) 2px, transparent 2px),
                radial-gradient(circle at 25% 85%, rgba(221, 160, 221, 0.3) 3px, transparent 3px);
            background-size: 180px 180px, 220px 220px, 160px 160px, 200px 200px, 190px 190px;
            animation: sparkle 8s linear infinite;
            pointer-events: none;
            z-index: 0;
        }

        .header {
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
        }

        .title {
            color: #4a5568;
            font-size: 1.8rem;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .score-board {
            display: flex;
            justify-content: space-around;
            background: linear-gradient(145deg, rgba(247, 250, 252, 0.9), rgba(237, 242, 247, 0.9));
            backdrop-filter: blur(10px);
            padding: 12px;
            border-radius: 15px;
            margin-bottom: 20px;
            border: 2px solid rgba(203, 213, 224, 0.6);
            position: relative;
            z-index: 1;
        }

        .score-item {
            text-align: center;
        }

        .score-number {
            font-size: 1.5rem;
            font-weight: bold;
            color: #2d3748;
        }

        .correct-score {
            color: #38a169;
        }

        .incorrect-score {
            color: #e53e3e;
        }

        .score-label {
            font-size: 0.9rem;
            color: #718096;
            margin-top: 5px;
        }

        .card {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(241, 245, 249, 0.9));
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 25px;
            margin: 15px 0;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            border: 3px solid rgba(226, 232, 240, 0.8);
            transition: all 0.3s ease;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            z-index: 1;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(0,0,0,0.15);
        }

        .problem {
            font-size: 2.5rem;
            color: #2d3748;
            margin-bottom: 25px;
            font-weight: bold;
        }

        .answer-input {
            font-size: 2rem;
            padding: 18px 25px;
            border: 3px solid #cbd5e0;
            border-radius: 15px;
            text-align: center;
            width: 150px;
            margin: 0 auto 20px auto;
            transition: border-color 0.3s ease;
            display: block;
            -webkit-appearance: none;
            -moz-appearance: textfield;
        }

        .answer-input:focus {
            outline: none;
            border-color: #4299e1;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1);
        }

        .buttons {
            margin-top: 25px;
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 18px 35px;
            border: none;
            border-radius: 15px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 140px;
            min-height: 55px;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }

        .btn-primary {
            background: linear-gradient(145deg, #4299e1, #3182ce);
            color: white;
        }

        .btn-primary:hover {
            background: linear-gradient(145deg, #3182ce, #2c5282);
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: linear-gradient(145deg, #48bb78, #38a169);
            color: white;
        }

        .btn-secondary:hover {
            background: linear-gradient(145deg, #38a169, #2f855a);
            transform: translateY(-2px);
        }

        .btn-hint {
            background: linear-gradient(145deg, #ed8936, #dd6b20);
            color: white;
        }

        .btn-hint:hover {
            background: linear-gradient(145deg, #dd6b20, #c05621);
            transform: translateY(-2px);
        }

        .feedback {
            margin-top: 20px;
            padding: 15px;
            border-radius: 15px;
            font-size: 1.2rem;
            font-weight: bold;
            min-height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
        }

        .feedback.correct {
            background: linear-gradient(145deg, #c6f6d5, #9ae6b4);
            color: #22543d;
        }

        .feedback.incorrect {
            background: linear-gradient(145deg, #fed7d7, #feb2b2);
            color: #742a2a;
        }

        .feedback.hint {
            background: linear-gradient(145deg, #feebc8, #fbd38d);
            color: #744210;
        }

        .progress-bar {
            background: rgba(226, 232, 240, 0.8);
            height: 10px;
            border-radius: 5px;
            margin: 20px 0;
            overflow: hidden;
            position: relative;
            z-index: 1;
            border: 1px solid rgba(203, 213, 224, 0.6);
        }

        .progress-fill {
            background: linear-gradient(90deg, #48bb78, #38a169);
            height: 100%;
            transition: width 0.5s ease;
            border-radius: 5px;
        }

        .celebration {
            font-size: 3rem;
            margin: 20px 0;
            animation: bounce 0.6s ease-in-out;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-20px); }
            60% { transform: translateY(-10px); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }

        @keyframes glow {
            0%, 100% { box-shadow: 0 0 5px rgba(66, 153, 225, 0.5); }
            50% { box-shadow: 0 0 20px rgba(66, 153, 225, 0.8); }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes confetti {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-100px) rotate(360deg); opacity: 0; }
        }

        .shake { animation: shake 0.5s ease-in-out; }
        .glow { animation: glow 1s ease-in-out infinite; }
        .fade-in { animation: fadeIn 0.5s ease-out; }

        .confetti-piece {
            position: absolute;
            width: 10px;
            height: 10px;
            background: #4299e1;
            animation: confetti 2s ease-out forwards;
        }

        .sound-toggle {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(255,255,255,0.9);
            border: none;
            border-radius: 50%;
            width: 55px;
            height: 55px;
            font-size: 1.6rem;
            cursor: pointer;
            transition: all 0.3s ease;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            z-index: 10;
        }

        .sound-toggle:hover {
            background: white;
            transform: scale(1.1);
        }

        /* Mobile-first design - no media queries needed */
        
        /* Prevent zoom on input focus */
        input[type="number"]:focus {
            font-size: 16px;
        }
        
        /* Hide number input spinners */
        .answer-input::-webkit-outer-spin-button,
        .answer-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Welcome Screen Styles */
        .welcome-screen, .mode-selection-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #FF6B6B 0%, #4ECDC4 25%, #45B7D1 50%, #96CEB4 75%, #FFEAA7 100%);
            background-size: 400% 400%;
            animation: gradientShift 10s ease infinite;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .welcome-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 40px 30px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            max-width: 90%;
            width: 400px;
            animation: welcomeBounce 1s ease-out;
        }

        @keyframes welcomeBounce {
            0% { transform: scale(0.3) rotate(-10deg); opacity: 0; }
            50% { transform: scale(1.05) rotate(2deg); }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }

        .welcome-title {
            font-size: 2.2rem;
            color: #2d3748;
            margin-bottom: 10px;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        .welcome-subtitle {
            font-size: 1.1rem;
            color: #4a5568;
            margin-bottom: 30px;
            font-weight: 600;
        }

        .floating-numbers {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            margin: 30px 0;
            padding: 20px;
            background: linear-gradient(145deg, #f7fafc, #edf2f7);
            border-radius: 20px;
        }

        .number-item {
            background: linear-gradient(145deg, #667eea, #764ba2);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: bold;
            animation: numberFloat 3s ease-in-out infinite;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .number-item:nth-child(odd) {
            background: linear-gradient(145deg, #FF6B6B, #FF8E53);
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.4);
            animation-delay: 0.5s;
        }

        .number-item:nth-child(4n) {
            background: linear-gradient(145deg, #4ECDC4, #44A08D);
            box-shadow: 0 4px 15px rgba(78, 205, 196, 0.4);
            animation-delay: 1s;
        }

        @keyframes numberFloat {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-10px) scale(1.1); }
        }

        .welcome-description {
            margin: 25px 0;
        }

        .welcome-description p {
            font-size: 1.1rem;
            color: #4a5568;
            margin: 8px 0;
            font-weight: 600;
        }

        .start-btn {
            background: linear-gradient(145deg, #48bb78, #38a169);
            color: white;
            border: none;
            padding: 20px 40px;
            font-size: 1.3rem;
            font-weight: bold;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(72, 187, 120, 0.4);
            animation: startBtnPulse 2s ease-in-out infinite;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }

        .start-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(72, 187, 120, 0.6);
        }

        @keyframes startBtnPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Mode Selection Screen Styles */
        .mode-selection-screen {
            display: none;
        }

        .mode-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 40px 30px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            max-width: 90%;
            width: 400px;
            animation: welcomeBounce 1s ease-out;
        }

        .mode-title {
            font-size: 2rem;
            color: #2d3748;
            margin-bottom: 15px;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        .mode-subtitle {
            font-size: 1.1rem;
            color: #4a5568;
            margin-bottom: 30px;
            font-weight: 600;
        }

        .mode-buttons {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin: 30px 0;
        }

        .mode-btn {
            background: linear-gradient(145deg, #667eea, #764ba2);
            color: white;
            border: none;
            padding: 25px 30px;
            font-size: 1.4rem;
            font-weight: bold;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }

        .mode-btn.addition {
            background: linear-gradient(145deg, #48bb78, #38a169);
            box-shadow: 0 8px 25px rgba(72, 187, 120, 0.4);
        }

        .mode-btn.subtraction {
            background: linear-gradient(145deg, #ed8936, #dd6b20);
            box-shadow: 0 8px 25px rgba(237, 137, 54, 0.4);
        }

        .mode-btn.mixed {
            background: linear-gradient(145deg, #9f7aea, #805ad5);
            box-shadow: 0 8px 25px rgba(159, 122, 234, 0.4);
        }

        .mode-btn.challenge {
            background: linear-gradient(145deg, #f56565, #e53e3e);
            box-shadow: 0 8px 25px rgba(245, 101, 101, 0.4);
        }

        .mode-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(0,0,0,0.3);
        }

        .mode-btn .mode-icon {
            font-size: 2rem;
        }

        .mode-btn .mode-text {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .mode-btn .mode-name {
            font-size: 1.4rem;
            margin-bottom: 5px;
        }

        .mode-btn .mode-desc {
            font-size: 1rem;
            opacity: 0.9;
            font-weight: normal;
        }

        .back-btn {
            background: linear-gradient(145deg, #a0aec0, #718096);
            color: white;
            border: none;
            padding: 15px 25px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(160, 174, 192, 0.4);
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            margin-top: 20px;
        }

        .back-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(160, 174, 192, 0.6);
        }

        .back-to-menu-btn {
            background: linear-gradient(145deg, #667eea, #764ba2);
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            margin-bottom: 15px;
        }

        .back-to-menu-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }
    </style>
</head>
<body>
    <div class="floating-shapes">
        <div class="shape">🌟</div>
        <div class="shape">🎈</div>
        <div class="shape">🌈</div>
        <div class="shape">⭐</div>
        <div class="shape">🎨</div>
        <div class="shape">🦄</div>
    </div>

    <button class="sound-toggle" id="sound-toggle" onclick="toggleSound()">🔊</button>
    
    <!-- Welcome Screen -->
    <div class="welcome-screen" id="welcome-screen">
        <div class="welcome-container">
            <h1 class="welcome-title">🎓 Učenje matematike</h1>
            <p class="welcome-subtitle">Za mlađu djecu od 4 do 8 godina</p>
            
            <div class="floating-numbers">
                <div class="number-item">1</div>
                <div class="number-item">+</div>
                <div class="number-item">2</div>
                <div class="number-item">=</div>
                <div class="number-item">3</div>
                <div class="number-item">5</div>
                <div class="number-item">-</div>
                <div class="number-item">2</div>
                <div class="number-item">=</div>
                <div class="number-item">3</div>
                <div class="number-item">7</div>
                <div class="number-item">+</div>
                <div class="number-item">3</div>
                <div class="number-item">=</div>
                <div class="number-item">10</div>
            </div>
            
            <div class="welcome-description">
                <p>🌟 Zabavno učenje brojeva</p>
                <p>🎯 Jednostavni zadaci</p>
                <p>🎉 Nagrade za točne odgovore</p>
            </div>
            
            <button class="start-btn" onclick="showModeSelection()">
                🚀 Počni igru!
            </button>
        </div>
    </div>

    <!-- Mode Selection Screen -->
    <div class="mode-selection-screen" id="mode-selection-screen">
        <div class="mode-container">
            <h1 class="mode-title">🎯 Odaberi način vježbanja</h1>
            <p class="mode-subtitle">Što želiš vježbati danas?</p>
            
            <div class="mode-buttons">
                <button class="mode-btn addition" onclick="startGame('addition')">
                    <div class="mode-icon">➕</div>
                    <div class="mode-text">
                        <div class="mode-name">Zbrajanje</div>
                        <div class="mode-desc">Vježbaj samo zbrajanje brojeva</div>
                    </div>
                </button>
                
                <button class="mode-btn subtraction" onclick="startGame('subtraction')">
                    <div class="mode-icon">➖</div>
                    <div class="mode-text">
                        <div class="mode-name">Oduzimanje</div>
                        <div class="mode-desc">Vježbaj samo oduzimanje brojeva</div>
                    </div>
                </button>
                
                <button class="mode-btn mixed" onclick="startGame('mixed')">
                    <div class="mode-icon">🔀</div>
                    <div class="mode-text">
                        <div class="mode-name">Miješano</div>
                        <div class="mode-desc">Zbrajanje i oduzimanje zajedno</div>
                    </div>
                </button>
                
                <button class="mode-btn challenge" onclick="startGame('challenge')">
                    <div class="mode-icon">🏆</div>
                    <div class="mode-text">
                        <div class="mode-name">Izazov</div>
                        <div class="mode-desc">Složeniji zadaci s više brojeva (1-20)</div>
                    </div>
                </button>
            </div>
            
            <button class="back-btn" onclick="goBackToWelcome()">
                ← Natrag
            </button>
        </div>
    </div>

    <div class="game-container" id="game-container" style="display: none;">
        <div class="header">
            <h1 class="title">🧮 Matematičke Kartice</h1>
            
            <button class="back-to-menu-btn" onclick="backToModeSelection()">
                ← Promijeni način
            </button>

            <div class="score-board">
                <div class="score-item">
                    <div class="score-number correct-score" id="correct-count">0</div>
                    <div class="score-label">✅ Točno</div>
                </div>
                <div class="score-item">
                    <div class="score-number incorrect-score" id="incorrect-count">0</div>
                    <div class="score-label">❌ Netočno</div>
                </div>
                <div class="score-item">
                    <div class="score-number" id="streak-count">0</div>
                    <div class="score-label">🔥 Niz</div>
                </div>
            </div>
        </div>

        <div class="progress-bar">
            <div class="progress-fill" id="progress-fill" style="width: 0%"></div>
        </div>

        <div class="card">
            <div class="problem" id="problem">8 + 5 = ?</div>
            <div>
                <input type="number" class="answer-input" id="answer-input" placeholder="?" autocomplete="off">
            </div>
            <div class="buttons">
                <button class="btn btn-secondary" onclick="nextProblem()">Sljedeći</button>
                <button class="btn btn-hint" onclick="showHint()">Savjet</button>
            </div>
        </div>

        <div class="feedback" id="feedback"></div>
    </div>

    <!-- Download Button -->
    <div style="position: fixed; top: 70px; right: 15px; z-index: 1000;">
        <button onclick="downloadApp()" style="background: linear-gradient(145deg, #4299e1, #3182ce); color: white; border: none; padding: 12px 16px; border-radius: 12px; font-size: 0.9rem; font-weight: bold; cursor: pointer; box-shadow: 0 4px 15px rgba(66, 153, 225, 0.4); transition: all 0.3s ease; touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
            📥 Preuzmi
        </button>
    </div>

    <script>
        // Download function
        function downloadApp() {
            try {
                // Get the complete HTML content
                let htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
                
                // Create blob with proper MIME type
                const blob = new Blob([htmlContent], { 
                    type: 'text/html;charset=utf-8' 
                });
                
                // Create download link
                const url = URL.createObjectURL(blob);
                const downloadLink = document.createElement('a');
                downloadLink.href = url;
                downloadLink.download = 'matematicke-kartice.html';
                downloadLink.style.display = 'none';
                
                // Add to DOM, click, and remove
                document.body.appendChild(downloadLink);
                downloadLink.click();
                
                // Clean up
                setTimeout(() => {
                    document.body.removeChild(downloadLink);
                    URL.revokeObjectURL(url);
                }, 100);
                
                // Show success message
                const originalText = event.target.textContent;
                event.target.textContent = '✅ Preuzeto!';
                event.target.style.background = 'linear-gradient(145deg, #48bb78, #38a169)';
                
                setTimeout(() => {
                    event.target.textContent = originalText;
                    event.target.style.background = 'linear-gradient(145deg, #4299e1, #3182ce)';
                }, 2000);
                
            } catch (error) {
                console.error('Greška pri preuzimanju:', error);
                
                // Fallback method - show instructions
                const instructions = `
Kopiraj ovaj kod i spremi kao .html datoteku:

1. Desni klik na stranicu → "Prikaži izvor stranice" ili "View Page Source"
2. Označi sve (Ctrl+A) i kopiraj (Ctrl+C)
3. Otvori Notepad ili bilo koji text editor
4. Zalijepi kod (Ctrl+V)
5. Spremi kao "matematicke-kartice.html"
6. Otvori datoteku u web pregledniku
                `;
                
                // Create modal with instructions
                const modal = document.createElement('div');
                modal.style.cssText = `
                    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
                    background: rgba(0,0,0,0.8); z-index: 10000; display: flex;
                    align-items: center; justify-content: center; padding: 20px;
                `;
                
                const content = document.createElement('div');
                content.style.cssText = `
                    background: white; padding: 30px; border-radius: 15px;
                    max-width: 500px; text-align: left; font-family: Arial, sans-serif;
                `;
                
                content.innerHTML = `
                    <h3 style="color: #e53e3e; margin-top: 0;">📥 Alternativni način preuzimanja</h3>
                    <pre style="background: #f7fafc; padding: 15px; border-radius: 8px; font-size: 0.9rem; white-space: pre-wrap;">${instructions}</pre>
                    <button onclick="this.parentElement.parentElement.remove()" style="background: #4299e1; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; margin-top: 15px;">Razumijem</button>
                `;
                
                modal.appendChild(content);
                document.body.appendChild(modal);
            }
        }

        let currentProblem = {};
        let correctAnswers = 0;
        let incorrectAnswers = 0;
        let currentStreak = 0;
        let maxStreak = 0;
        let hintUsed = false;
        let soundEnabled = true;
        let answerTimeout = null;
        let gameMode = 'mixed'; // 'addition', 'subtraction', or 'mixed'

        // Sound effects using Web Audio API
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        
        function playSound(frequency, duration, type = 'sine') {
            if (!soundEnabled) return;
            
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            
            oscillator.frequency.setValueAtTime(frequency, audioContext.currentTime);
            oscillator.type = type;
            
            gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + duration);
            
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + duration);
        }

        function playCorrectSound() {
            playSound(523, 0.2); // C5
            setTimeout(() => playSound(659, 0.2), 100); // E5
            setTimeout(() => playSound(784, 0.3), 200); // G5
        }

        function playIncorrectSound() {
            playSound(220, 0.5, 'sawtooth'); // A3
        }

        function playTickSound() {
            playSound(800, 0.1, 'square');
        }

        function playTimeUpSound() {
            for(let i = 0; i < 3; i++) {
                setTimeout(() => playSound(200, 0.3, 'sawtooth'), i * 200);
            }
        }

        function generateProblem() {
            if (gameMode === 'challenge') {
                // Generate complex problems with multiple operations for children
                const problemTypes = ['triple_add', 'triple_mixed', 'double_subtract', 'add_subtract_chain'];
                const problemType = problemTypes[Math.floor(Math.random() * problemTypes.length)];
                
                let num1, num2, num3, answer, display;
                
                if (problemType === 'triple_add') {
                    // Three numbers addition: 5 + 3 + 2 = ?
                    num1 = Math.floor(Math.random() * 8) + 2; // 2-9
                    num2 = Math.floor(Math.random() * 6) + 1; // 1-6
                    num3 = Math.floor(Math.random() * (20 - num1 - num2)) + 1; // Ensure sum ≤ 20
                    answer = num1 + num2 + num3;
                    display = `${num1} + ${num2} + ${num3} = ?`;
                } else if (problemType === 'triple_mixed') {
                    // Mixed operations: 15 - 3 + 2 = ?
                    num1 = Math.floor(Math.random() * 10) + 10; // 10-19
                    num2 = Math.floor(Math.random() * 5) + 1; // 1-5
                    num3 = Math.floor(Math.random() * 5) + 1; // 1-5
                    answer = num1 - num2 + num3;
                    display = `${num1} - ${num2} + ${num3} = ?`;
                } else if (problemType === 'double_subtract') {
                    // Double subtraction: 18 - 3 - 2 = ?
                    num1 = Math.floor(Math.random() * 8) + 12; // 12-19
                    num2 = Math.floor(Math.random() * 4) + 1; // 1-4
                    num3 = Math.floor(Math.random() * 4) + 1; // 1-4
                    // Ensure result is positive
                    if (num1 - num2 - num3 < 1) {
                        num2 = Math.floor(Math.random() * 3) + 1;
                        num3 = Math.floor(Math.random() * 3) + 1;
                    }
                    answer = num1 - num2 - num3;
                    display = `${num1} - ${num2} - ${num3} = ?`;
                } else if (problemType === 'add_subtract_chain') {
                    // Add then subtract: 8 + 5 - 3 = ?
                    num1 = Math.floor(Math.random() * 8) + 3; // 3-10
                    num2 = Math.floor(Math.random() * 6) + 2; // 2-7
                    num3 = Math.floor(Math.random() * 5) + 1; // 1-5
                    // Ensure result is positive and ≤ 20
                    if (num1 + num2 > 20) {
                        num2 = Math.floor(Math.random() * 4) + 2;
                    }
                    if (num1 + num2 - num3 < 1) {
                        num3 = Math.floor(Math.random() * 3) + 1;
                    }
                    answer = num1 + num2 - num3;
                    display = `${num1} + ${num2} - ${num3} = ?`;
                }
                
                return {
                    num1: num1,
                    num2: num2,
                    num3: num3,
                    operation: 'complex',
                    answer: answer,
                    display: display,
                    type: problemType
                };
            } else {
                // Regular problems for other modes
                let operations = [];
                
                if (gameMode === 'addition') {
                    operations = ['+'];
                } else if (gameMode === 'subtraction') {
                    operations = ['-'];
                } else {
                    operations = ['+', '-'];
                }
                
                const operation = operations[Math.floor(Math.random() * operations.length)];
                let num1, num2, answer;
                
                if (operation === '+') {
                    num1 = Math.floor(Math.random() * 15) + 1; // 1-15
                    num2 = Math.floor(Math.random() * (20 - num1)) + 1; // Ensure sum ≤ 20
                    answer = num1 + num2;
                } else {
                    num1 = Math.floor(Math.random() * 19) + 2; // 2-20
                    num2 = Math.floor(Math.random() * num1) + 1; // 1 to num1
                    answer = num1 - num2;
                }
                
                return {
                    num1: num1,
                    num2: num2,
                    operation: operation,
                    answer: answer,
                    display: `${num1} ${operation} ${num2} = ?`
                };
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('sound-toggle').textContent = soundEnabled ? '🔊' : '🔇';
        }

        function createConfetti() {
            const colors = ['#4299e1', '#48bb78', '#ed8936', '#9f7aea', '#f56565'];
            const container = document.querySelector('.game-container');
            
            for (let i = 0; i < 20; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti-piece';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.animationDelay = Math.random() * 0.5 + 's';
                container.appendChild(confetti);
                
                setTimeout(() => confetti.remove(), 2000);
            }
        }

        function displayProblem() {
            currentProblem = generateProblem();
            document.getElementById('problem').textContent = currentProblem.display;
            document.getElementById('answer-input').value = '';
            document.getElementById('answer-input').focus();
            document.getElementById('feedback').textContent = '';
            document.getElementById('feedback').className = 'feedback';
            hintUsed = false;
            
            const card = document.querySelector('.card');
            card.classList.add('fade-in');
            setTimeout(() => card.classList.remove('fade-in'), 500);
        }

        function checkAnswer() {
            const userAnswer = parseInt(document.getElementById('answer-input').value);
            const feedback = document.getElementById('feedback');
            
            if (isNaN(userAnswer)) {
                return; // Don't show error for empty input
            }
            
            if (userAnswer === currentProblem.answer) {
                correctAnswers++;
                currentStreak++;
                maxStreak = Math.max(maxStreak, currentStreak);
                
                playCorrectSound();
                
                const celebrations = ['🎉 Bravo!', '✨ Odlično!', '🌟 Fantastično!', '🎊 Savršeno!', '💫 Izvrsno!'];
                const celebration = celebrations[Math.floor(Math.random() * celebrations.length)];
                
                feedback.innerHTML = `<div class="celebration">${celebration}</div>Točan odgovor!`;
                feedback.className = 'feedback correct';
                
                const card = document.querySelector('.card');
                card.classList.add('glow');
                
                if (currentStreak >= 5) {
                    createConfetti();
                }
                
                setTimeout(() => {
                    card.classList.remove('glow');
                    nextProblem();
                }, 1500);
            } else {
                incorrectAnswers++;
                currentStreak = 0;
                playIncorrectSound();
                
                feedback.textContent = `❌ Netočno. Točan odgovor je ${currentProblem.answer}.`;
                feedback.className = 'feedback incorrect';
                
                const card = document.querySelector('.card');
                card.classList.add('shake');
                
                setTimeout(() => {
                    card.classList.remove('shake');
                    nextProblem();
                }, 1500);
            }
            
            updateScoreboard();
        }

        function showHint() {
            if (hintUsed) return;
            
            playSound(440, 0.3); // A4 note for hint
            
            const feedback = document.getElementById('feedback');
            let hint = '';
            
            if (gameMode === 'challenge' && currentProblem.operation === 'complex') {
                if (currentProblem.type === 'triple_add') {
                    hint = `💡 Savjet: Prvo dodaj ${currentProblem.num1} + ${currentProblem.num2} = ${currentProblem.num1 + currentProblem.num2}, zatim dodaj ${currentProblem.num3}!`;
                } else if (currentProblem.type === 'triple_mixed') {
                    hint = `💡 Savjet: Prvo oduzmi ${currentProblem.num1} - ${currentProblem.num2} = ${currentProblem.num1 - currentProblem.num2}, zatim dodaj ${currentProblem.num3}!`;
                } else if (currentProblem.type === 'double_subtract') {
                    hint = `💡 Savjet: Prvo oduzmi ${currentProblem.num1} - ${currentProblem.num2} = ${currentProblem.num1 - currentProblem.num2}, zatim oduzmi ${currentProblem.num3}!`;
                } else if (currentProblem.type === 'add_subtract_chain') {
                    hint = `💡 Savjet: Prvo dodaj ${currentProblem.num1} + ${currentProblem.num2} = ${currentProblem.num1 + currentProblem.num2}, zatim oduzmi ${currentProblem.num3}!`;
                }
            } else if (currentProblem.operation === '+') {
                hint = `💡 Savjet: Počni s ${currentProblem.num1} i dodaj ${currentProblem.num2}. Možeš brojati na prstima!`;
            } else if (currentProblem.operation === '-') {
                hint = `💡 Savjet: Počni s ${currentProblem.num1} i oduzmi ${currentProblem.num2}. Možeš brojati unazad!`;
            }
            
            feedback.textContent = hint;
            feedback.className = 'feedback hint';
            hintUsed = true;
        }

        function nextProblem() {
            displayProblem();
        }

        function updateScoreboard() {
            document.getElementById('correct-count').textContent = correctAnswers;
            document.getElementById('incorrect-count').textContent = incorrectAnswers;
            document.getElementById('streak-count').textContent = currentStreak;
            
            const totalAnswers = correctAnswers + incorrectAnswers;
            const percentage = totalAnswers > 0 ? (correctAnswers / totalAnswers) * 100 : 0;
            document.getElementById('progress-fill').style.width = percentage + '%';
        }

        // Event listeners
        document.getElementById('answer-input').addEventListener('input', function(e) {
            // Clear any existing timeout
            if (answerTimeout) {
                clearTimeout(answerTimeout);
            }
            
            const userAnswer = parseInt(e.target.value);
            if (!isNaN(userAnswer) && userAnswer.toString() === e.target.value.trim()) {
                // Wait 2000ms after user stops typing to check answer
                answerTimeout = setTimeout(() => {
                    checkAnswer();
                }, 2000);
            }
        });
        
        document.getElementById('answer-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                // Clear timeout and check immediately on Enter
                if (answerTimeout) {
                    clearTimeout(answerTimeout);
                }
                checkAnswer();
            }
        });

        // Show mode selection screen
        function showModeSelection() {
            document.getElementById('welcome-screen').style.display = 'none';
            document.getElementById('mode-selection-screen').style.display = 'flex';
        }

        // Go back to welcome screen
        function goBackToWelcome() {
            document.getElementById('mode-selection-screen').style.display = 'none';
            document.getElementById('welcome-screen').style.display = 'flex';
        }

        // Start game function with mode selection
        function startGame(mode = 'mixed') {
            gameMode = mode;
            document.getElementById('mode-selection-screen').style.display = 'none';
            document.getElementById('game-container').style.display = 'flex';
            
            // Update title based on mode
            const title = document.querySelector('.title');
            if (mode === 'addition') {
                title.textContent = '➕ Vježbanje zbrajanja';
            } else if (mode === 'subtraction') {
                title.textContent = '➖ Vježbanje oduzimanja';
            } else if (mode === 'challenge') {
                title.textContent = '🏆 Izazov - Napredni zadaci';
            } else {
                title.textContent = '🧮 Matematičke Kartice';
            }
            
            // Initialize the game
            displayProblem();
            updateScoreboard();
        }

        // Go back to mode selection from game
        function backToModeSelection() {
            document.getElementById('game-container').style.display = 'none';
            document.getElementById('mode-selection-screen').style.display = 'flex';
            
            // Reset game state
            correctAnswers = 0;
            incorrectAnswers = 0;
            currentStreak = 0;
            hintUsed = false;
            
            // Clear any pending timeouts
            if (answerTimeout) {
                clearTimeout(answerTimeout);
            }
        }
    </script>
